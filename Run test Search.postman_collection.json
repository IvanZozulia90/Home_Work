		{
			"name": "Search Assortment",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"\r",
							"var testCases = [\r",
							"    {\r",
							"        testName: \"Valid barcode\",\r",
							"        testData: {\r",
							"            barcode: 11522159152189\r",
							"        },\r",
							"        expectedResult:{\r",
							"            statusCode: 200\r",
							"        }\r",
							"    },\r",
							"    {\r",
							"        testName: \"Valid assortment\",\r",
							"        testData: {\r",
							"            assortmentId: 1773\r",
							"        },\r",
							"        expectedResult:{\r",
							"            statusCode: 200\r",
							"        }\r",
							"    },\r",
							"    {\r",
							"        testName: \"Valid search\",\r",
							"        testData: {\r",
							"            name: \"кав\"\r",
							"        },\r",
							"        expectedResult:{\r",
							"            statusCode: 200\r",
							"        }\r",
							"    },\r",
							"    {\r",
							"        testName: \"Not valid barcode\",\r",
							"        testData: {\r",
							"            barcode: 1010101\r",
							"        },\r",
							"        expectedResult:{\r",
							"            statusCode: 400,\r",
							"            error: \"The length of 'barcode' must be at least 8 characters. You entered 7 characters.\"\r",
							"        }\r",
							"    }\r",
							"];\r",
							"\r",
							"if (!pm.collectionVariables.get(\"testCases\")){\r",
							"    pm.collectionVariables.set(\"testCases\", JSON.stringify(testCases));\r",
							"    pm.collectionVariables.set(\"testIndex\", 0);\r",
							"};\r",
							"\r",
							"var index = parseInt(pm.collectionVariables.get(\"testIndex\"));\r",
							"var test = JSON.parse(pm.collectionVariables.get(\"testCases\"));\r",
							"var current = test[index];\r",
							"console.log(index);\r",
							"\r",
							"pm.collectionVariables.set(\"testName\", current.testName);\r",
							"pm.collectionVariables.set(\"expectedStatusCode\", current.expectedResult.statusCode);\r",
							"pm.collectionVariables.set(\"error\", current.expectedResult.error);\r",
							"\r",
							"pm.request.url.query.clear();\r",
							"pm.request.url.query.add({ key: \"filialId\", value: \"1\" });\r",
							"\r",
							"Object.entries(current.testData).forEach(([key, value]) => {\r",
							"    pm.request.url.query.add({ key, value: String(value) });\r",
							"});\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"\r",
							"var respBody = pm.response.json();\r",
							"\r",
							"// var re_call = pm.collectionVariables.get(\"re_call\");\r",
							"// console.log(\"Next request:\", re_call);\r",
							"\r",
							"var index = parseInt(pm.collectionVariables.get(\"testIndex\"));\r",
							"var tests = JSON.parse(pm.collectionVariables.get(\"testCases\"));\r",
							"var current = tests[index];\r",
							"var test = pm.collectionVariables.get(\"testName\");\r",
							"var status = pm.collectionVariables.get(\"expectedStatusCode\");\r",
							"var error = pm.collectionVariables.get(\"error\");\r",
							"\r",
							"pm.test(`Status code of \"${test}\"`, function () {\r",
							"    if (status == \"400\"){\r",
							"        pm.expect(pm.response.code).to.eql(status);\r",
							"        pm.expect(respBody.validationPropsErrors.barcode[0]).to.eql(error);\r",
							"    }else if (status == \"200\"){\r",
							"        pm.expect(pm.response.code).to.eql(status);\r",
							"        pm.expect(respBody, \"Object response must not be empty\").to.not.be.empty;\r",
							"    }\r",
							"});\r",
							"\r",
							"index++;\r",
							"pm.collectionVariables.set(\"testIndex\", index.toString());\r",
							"\r",
							"if (index < tests.length) {\r",
							"    pm.execution.setNextRequest(\"Search Assortment\");\r",
							"}else{\r",
							"    pm.collectionVariables.unset(\"testIndex\");\r",
							"    pm.collectionVariables.unset(\"testCases\");\r",
							"    pm.execution.setNextRequest(\"Info Assortment\")\r",
							"}\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
