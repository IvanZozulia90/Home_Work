				{
					"name": "GetAllAbstractCities",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"\r",
									"let respBody = pm.response.json();\r",
									"\r",
									"let all = respBody.data.getAllCities;\r",
									"\r",
									"let ids = all.map(city => city.id);\r",
									"// console.log(\"all id\", ids);\r",
									"\r",
									"let randomId = [];\r",
									"\r",
									"while (randomId.length < 4) {\r",
									"    let id = ids[Math.floor(Math.random() * ids.length)];\r",
									"    if (!randomId.includes(id)) {\r",
									"        randomId.push(id);\r",
									"    }\r",
									"}\r",
									"console.log(randomId);\r",
									"pm.collectionVariables.set(\"randomId\", randomId);\r",
									"\r",
									"let cities = all.filter(city => randomId.includes(city.id));\r",
									"console.log(cities);\r",
									"\r",
									"let squares = cities.map(city => Number(city.square));\r",
									"console.log(squares);\r",
									"\r",
									"let sum = 0;\r",
									"for (let i = 0; i < squares.length; i++) {\r",
									"    sum += squares[i];\r",
									"};\r",
									"let midleSquares = sum / squares.length;\r",
									"console.log(midleSquares);\r",
									"pm.collectionVariables.set(\"midleSquares\", midleSquares);\r",
									"\r",
									"pm.test(\"Response has no errors\", function() {\r",
									"    pm.expect(respBody).to.not.have.property(\"errors\");\r",
									"});\r",
									"\r",
									"pm.test(\"Response has correct structure\", function() {\r",
									"    pm.expect(respBody.data).to.have.property(\"getAllCities\");\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
