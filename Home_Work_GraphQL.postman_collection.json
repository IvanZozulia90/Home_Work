					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let respBody = pm.response.json();",
									"let currentId = pm.collectionVariables.get(\"randomId\");",
									"",
									"let all = respBody.data.getCitiesByIds;",
									"let ids = all.map(city => city.id);",
									"",
									"let min = Math.min(...ids);",
									"let max = Math.max(...ids);",
									"console.log(min);",
									"console.log(max);",
									"pm.collectionVariables.set(\"min\", min);",
									"pm.collectionVariables.set(\"max\", max);",
									"",
									"pm.test(\"Check ids\", function(){",
									"    pm.expect(ids).to.eql(currentId)",
									"});",
									"",
									"",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
